# =================================================================
# AI Meeting Intelligence Platform - Backend Environment Config
# =================================================================

# Django
SECRET_KEY=meeting-intel-production-secret-key-change-me-xyz-2026
DEBUG=True

# MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# If left empty, the backend automatically uses the built-in local JSON document store in /data
MONGO_URI=
MONGO_DB_NAME=meeting_intelligence

# Groq API Configuration
# Get your free API key at: https://console.groq.com/keys
# Whisper STT & LLM (Llama 3.3 70B) are both hosted on Groq!
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
WHISPER_MODEL=whisper-large-v3

# JWT Configuration
JWT_SECRET=meeting-intel-production-secret-key-change-me-xyz-2026
JWT_EXPIRATION_HOURS=72

# Redis & Celery (Optional - pipeline falls back automatically to threading if not installed)
REDIS_URL=redis://localhost:6379/0

# Object Storage (Optional for AWS S3 / Cloudinary)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Usage Limits (Section 14 & 78)
MAX_UPLOAD_SIZE_MB=200
FREE_MEMBER_MONTHLY_MEETINGS=5
FREE_MEMBER_MAX_DURATION_MINUTES=60
